# Talent IA Backend - Environment Variables Template
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# NEVER COMMIT .env TO VERSION CONTROL

# ===== REQUIRED - AI PROVIDERS =====
GEMINI_API_KEY=REEMPLAZAR_CON_GEMINI_API_KEY
OPENAI_API_KEY=REEMPLAZAR_CON_OPENAI_API_KEY
ANTHROPIC_API_KEY=REEMPLAZAR_CON_ANTHROPIC_API_KEY

# ===== REQUIRED - DATABASE =====
DATABASE_URL=postgresql://user:REEMPLAZAR_CON_PASSWORD_BD@host:5432/dbname
DB_PASSWORD=REEMPLAZAR_CON_PASSWORD_BD

# ===== REQUIRED - AUTH =====
JWT_SECRET=REEMPLAZAR_CON_JWT_SECRET_HEX_48
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# ===== REQUIRED - N8N WEBHOOKS =====
N8N_CANDIDATE_SYNC_WEBHOOK=https://your-n8n-domain/webhook/candidato-sync
N8N_VACANCY_SYNC_WEBHOOK=https://your-n8n-domain/webhook/vacancia-sync
N8N_ENTREVISTA_WEBHOOK=https://your-n8n-domain/webhook/candidato-entrevista
N8N_RECOVERY_EMAIL_WEBHOOK=https://your-n8n-domain/webhook/recovery-email

# ===== OPTIONAL - APP =====
NODE_ENV=production
PORT=3000
APP_URL=https://recruiting.easconsulting.com.mx

# ===== OPTIONAL - CORS =====
ALLOWED_ORIGINS=https://recruiting.easconsulting.com.mx,https://talent.easconsulting.com.mx

# ===== OPTIONAL - RATE LIMITING =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
