# =============================================================================
# Talent IA Backend - Variables de entorno (.env.example)
# Copia a `.env` en el servidor (NO versionar `.env`).
# =============================================================================

# --- Obligatorias -------------------------------------------------------------
DATABASE_URL="postgresql://n8n_user:REEMPLAZAR_CON_PASSWORD_BD@10.10.10.103:5432/n8n_db"
# Secreto de firma JWT (min. 32 caracteres). Generar con: openssl rand -hex 48
JWT_SECRET="REEMPLAZAR_CON_JWT_SECRET_HEX_48"

# --- Primer administrador -----------------------------------------------------
ADMIN_BOOTSTRAP_EMAIL="admin@easconsulting.com.mx"
ADMIN_BOOTSTRAP_PASSWORD="REEMPLAZAR_CON_PASSWORD_ADMIN_SEGURO"

# --- Opcionales ---------------------------------------------------------------
JWT_EXPIRES_IN="8h"
DATABASE_SSL=""
DATABASE_SSL_CA=""
DATABASE_CONNECT_TIMEOUT_MS="10000"
CORS_ORIGINS=""
TRUST_PROXY="loopback, uniquelocal"
STORAGE_MODE=""
SEED_SAMPLE_DATA="false"

# --- Motores IA ---------------------------------------------------------------
GEMINI_API_KEY="REEMPLAZAR_CON_GEMINI_API_KEY"
OPENAI_API_KEY="REEMPLAZAR_CON_OPENAI_API_KEY"
ANTHROPIC_API_KEY="REEMPLAZAR_CON_ANTHROPIC_API_KEY"

# --- Webhooks n8n -------------------------------------------------------------
N8N_CANDIDATE_SYNC_WEBHOOK="http://10.10.10.103:5678/webhook/candidato-sync"
N8N_VACANCY_SYNC_WEBHOOK="http://10.10.10.103:5678/webhook/vacancia-sync"
N8N_ENTREVISTA_WEBHOOK="http://10.10.10.103:5678/webhook/candidato-entrevista"
N8N_RECOVERY_EMAIL_WEBHOOK="http://10.10.10.103:5678/webhook/recovery-email"
