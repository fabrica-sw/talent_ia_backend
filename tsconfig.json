{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "resolveJsonModule": true,
    "outDir": "dist"
  },
  "include": [
    "server.ts",
    "src/**/*"
  ],
  "exclude": [
    "**/*.test.ts"
  ]
}